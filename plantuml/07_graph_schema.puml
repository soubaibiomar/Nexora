@startuml Schema_Graphe_Neo4j
' ═══════════════════════════════════════════════════
'  Schéma du Graphe — Modèle de Données Neo4j
' ═══════════════════════════════════════════════════

skinparam backgroundColor #FEFEFE

skinparam object {
    BackgroundColor #E8F0FE
    BorderColor #2B6CB0
    FontColor #1A365D
    HeaderBackgroundColor #2B6CB0
    HeaderFontColor #FFFFFF
    ArrowColor #2B6CB0
}

title Schéma du Graphe — Modèle de Données Neo4j

object "Expert" as E {
    id : String
    name : String
    email : String
    department : String
    role : String
    location : String
    experience_years : Integer
    expertise_level : String
    hire_date : Date
    skills : List<String>
}

object "Skill" as S {
    id : String
    name : String
    category : String
    level : String
    demand : Integer
}

object "Project" as P {
    id : String
    name : String
    domain : String
    status : String
    priority : String
    budget : Float
    tech_stack : List<String>
    required_skills : List<String>
    team_members : List<String>
}

object "Document" as D {
    id : String
    title : String
    type : String
    topic : String
    content : String
    author : String
    date : Date
    views : Integer
    rating : Float
}

object "Topic" as T {
    id : String
    name : String
}

' ── Relations ──
E --> S : HAS_SKILL
E --> P : WORKS_ON
E --> D : AUTHORED
E --> E : KNOWS
P --> S : REQUIRES_SKILL
D --> T : COVERS_TOPIC

@enduml
