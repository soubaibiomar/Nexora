@startuml Diagramme_Cas_Utilisation
' ═══════════════════════════════════════════════════
'  Diagramme de Cas d'Utilisation — Nexora
' ═══════════════════════════════════════════════════

left to right direction
skinparam packageStyle rectangle
skinparam backgroundColor #FEFEFE
skinparam handwritten false

skinparam usecase {
    BackgroundColor #E8F0FE
    BorderColor #2B6CB0
    FontColor #1A365D
    ArrowColor #2B6CB0
    StereotypeFontColor #2B6CB0
}

skinparam actor {
    BackgroundColor #2B6CB0
    BorderColor #1A365D
    FontColor #1A365D
}

' ── Acteurs ──
actor "Utilisateur" as U
actor "Manager" as M
actor "Administrateur" as A

U <|-- M
M <|-- A

rectangle "Nexora — Plateforme d'Intelligence Organisationnelle" {

    package "Authentification & Accès" {
        usecase "S'inscrire" as UC01
        usecase "Se connecter" as UC02
    }

    package "Intelligence Artificielle & Graphe" {
        usecase "Explorer le graphe 3D" as UC03
        usecase "Rechercher un expert" as UC04
        usecase "Voir recommandations" as UC05
        usecase "Poser une question à Veda" as UC06
        usecase "Voir parcours d'apprentissage" as UC07
    }

    package "Collaboration & Social" {
        usecase "Composer une équipe" as UC08
        usecase "Communiquer (Chat)" as UC09
        usecase "Publier dans le fil" as UC10
    }

    package "Management & Analytique" {
        usecase "Voir compétences émergentes" as UC11
        usecase "Voir prévisions de demande" as UC12
        usecase "Voir suggestions collaboration" as UC13
        usecase "Consulter le dashboard" as UC14
    }

    package "Administration" {
        usecase "Gérer les utilisateurs" as UC15
        usecase "Modifier les rôles" as UC16
        usecase "Accéder métriques Big Data" as UC17
    }
}

' ── Relations Utilisateur ──
U --> UC01
U --> UC02
U --> UC03
U --> UC04
U --> UC05
U --> UC06
U --> UC07
U --> UC08
U --> UC09
U --> UC10

' ── Relations Manager ──
M --> UC11
M --> UC12
M --> UC13
M --> UC14

' ── Relations Administrateur ──
A --> UC15
A --> UC16
A --> UC17

' ── Dépendances ──
UC03 ..> UC02 : <<include>>
UC04 ..> UC02 : <<include>>
UC05 ..> UC02 : <<include>>
UC06 ..> UC02 : <<include>>
UC07 ..> UC02 : <<include>>
UC08 ..> UC02 : <<include>>
UC09 ..> UC02 : <<include>>
UC10 ..> UC02 : <<include>>
UC11 ..> UC02 : <<include>>
UC12 ..> UC02 : <<include>>
UC13 ..> UC02 : <<include>>
UC14 ..> UC02 : <<include>>
UC15 ..> UC02 : <<include>>
UC16 ..> UC02 : <<include>>
UC17 ..> UC02 : <<include>>

@enduml
