@startuml Sequence_Recommandation
' ═══════════════════════════════════════════════════
'  Diagramme de Séquence — Recommandation d'Expert
' ═══════════════════════════════════════════════════

skinparam backgroundColor #FEFEFE
skinparam sequenceArrowThickness 2

skinparam participant {
    BackgroundColor #E8F0FE
    BorderColor #2B6CB0
    FontColor #1A365D
}

skinparam sequence {
    ArrowColor #2B6CB0
    LifeLineBorderColor #2B6CB0
    LifeLineBackgroundColor #EBF4FF
    GroupBackgroundColor #F7FAFC
    GroupBorderColor #2B6CB0
    DividerBackgroundColor #EBF4FF
    DividerBorderColor #2B6CB0
}

title Séquence — Recommandation d'Expert (TF-IDF + Cosinus)

participant "Frontend" as F
participant "Backend" as B
database "Database" as DB

F -> B : POST /api/ai/recommend\n{query: "expert en machine learning"}
activate B

B -> DB : Fetch expert profiles
activate DB
DB --> B : Liste des profils\n(skills, department, experience...)
deactivate DB

B -> B : Vectoriser les profils (TF-IDF)

B -> B : Vectoriser la requête

B -> B : Calculer similarité cosinus\n(vecteur_requête, matrice_profils)

B -> B : Trier par score\ndécroissant (top K)

B --> F : 200 OK\n[{name, department, skills, score}, ...]
deactivate B

@enduml
